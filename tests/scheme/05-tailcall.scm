(define (loop n) (if (= n 0) 'done (loop (- n 1))))
(assert-equal 'done (loop 1000000))
(define (sum-iter n acc) (if (= n 0) acc (sum-iter (- n 1) (+ acc n))))
(assert-equal 500000500000 (sum-iter 1000000 0))
(define (my-even? n) (if (= n 0) #t (my-odd? (- n 1))))
(define (my-odd? n) (if (= n 0) #f (my-even? (- n 1))))
(assert-equal #t (my-even? 300000))
(assert-equal 'ok (let lp ((i 0)) (cond ((= i 300000) 'ok) (else (lp (+ i 1))))))
(assert-equal 300000 (do ((i 0 (+ i 1))) ((= i 300000) i)))
(define (tail-and n) (and #t (if (= n 0) 'end (tail-and (- n 1)))))
(assert-equal 'end (tail-and 200000))
(define (tail-or n) (or #f (if (= n 0) 'end (tail-or (- n 1)))))
(assert-equal 'end (tail-or 200000))
(define (tail-when n) (when #t (if (= n 0) 'end (tail-when (- n 1)))))
(assert-equal 'end (tail-when 200000))
(define (tail-apply n) (if (= n 0) 'end (apply tail-apply (list (- n 1)))))
(assert-equal 'end (tail-apply 200000))

;;; 非尾遞迴很深,不能讓 Python 爆堆疊
(define (count-up n) (if (= n 0) 0 (+ 1 (count-up (- n 1)))))
(assert-equal 100000 (count-up 100000))
(define (build n) (if (= n 0) '() (cons n (build (- n 1)))))
(assert-equal 50000 (length (build 50000)))
(assert-equal 100000 (length (iota 100000)))
(assert-equal 50000 (length (map (lambda (x) (+ x 1)) (iota 50000))))
(assert-equal 4999950000 (fold-left + 0 (iota 100000)))
(assert-equal 4999950000 (fold-right + 0 (iota 100000)))
(assert-equal 50000 (length (append (iota 25000) (iota 25000))))
(assert-equal 1000 (vector-length (make-vector 1000 0)))
(define (deep-list n) (if (= n 0) '() (list (deep-list (- n 1)))))
(assert-true (list? (deep-list 500)))
(assert-error "recursion depth exceeded" (let inf ((n 0)) (+ 1 (inf n))))
